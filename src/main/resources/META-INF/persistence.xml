
<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             version="3.2">

    <persistence-unit name="laboratorioPU"
                      transaction-type="RESOURCE_LOCAL">

        <provider>
            org.hibernate.jpa.HibernatePersistenceProvider
        </provider>

        <class>ni.edu.uam.proyectolaboratorio.model.Equipo</class>
        <class>ni.edu.uam.proyectolaboratorio.model.TipoEquipo</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver"
                      value="org.postgresql.Driver"/>

            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:postgresql://localhost:5432/bd_universidad"/>

            <property name="jakarta.persistence.jdbc.user"
                      value="postgres"/>

            <property name="hibernate.hbm2ddl.auto"
                      value="validate"/>

            <property name="hibernate.default_schema"
                      value="laboratorio"/>

            <property name="hibernate.show_sql"
                      value="true"/>

            <property name="hibernate.format_sql"
                      value="true"/>
        </properties>

    </persistence-unit>
</persistence>

